#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q       &kp W       &kp E       &kp R       &kp T

                &kp LSHIFT &kp A       &kp S       &kp D       &kp F       &kp G

                &kp LCTRL  &kp Z       &kp X       &kp C       &kp V       &kp B

                &kp LALT   &kp LGUI    &kp SPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
                default_layer {
            display-name = "default";
            // ------------------------------------------------------------------------------------------------------------
            // |       |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |       |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |  BSPC |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |                   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | CTRL  | ALT | ENTER|                   | SPACE| CTRL  |  GUI  |
                        bindings = <
                      &kp Q  &kp W    &kp E    &kp R     &kp T                &kp Y  &kp U     &kp I     &kp O    &kp P  
            &kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp BSPC
            &kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B                &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                   &kp LCTRL &kp LALT  &kp RET                &kp SPACE  kp RCTRL  &kp RGUI
                        >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

    };
};